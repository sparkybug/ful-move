# Never copy local secrets, generated caches, databases, or dev-server markers.
**/.env
**/.env.*
**/*.pem
**/*.key
**/*.sql
**/*.sqlite
**/*.sqlite-*
bootstrap/cache/**
public/build
public/hot
public/storage
