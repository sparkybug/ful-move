APP_NAME="FUL Move"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US
APP_MAINTENANCE_DRIVER=file
BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=ful_shuttle
DB_USERNAME=root
DB_PASSWORD=
MYSQL_ATTR_SSL_CA=

# Set TRUSTED_PROXIES=* only behind Render or another trusted reverse proxy.
TRUSTED_PROXIES=

# Docker demo startup: seed sample data and open missing sample boarding runs.
RUN_SEEDERS=false

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=false

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync
CACHE_STORE=file
MAIL_MAILER=log

VITE_APP_NAME="${APP_NAME}"

